QAVA_DATABASE_URL=sqlite+aiosqlite:///.local/qava.db
QAVA_ARTIFACT_ROOT=.local/artifacts
QAVA_TRUSTED_IDENTITY_HEADER=X-Qava-Identity
QAVA_ASSISTANCE_MODE=disabled
# Optional Vite override. Development otherwise uses a respondent-only local identity.
VITE_QAVA_IDENTITY={"actor_id":"qava-web-respondent","roles":["respondent"]}