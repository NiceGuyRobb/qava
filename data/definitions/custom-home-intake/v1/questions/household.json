              "Adult",
              "Older adult"
            ]
          },
          {
            "key": "needs",
            "label": "Relevant needs",
            "component": "multi_select",
            "options": [
              "Private bedroom",
              "Dedicated bathroom",
              "Work or study space",
              "Accessibility considerations",
              "Independent living area",
              "No special requirements"
            ]
          }
        ]
      }
    },
    {
      "id": "pets",
      "type": "defined",
      "topic_id": "household",
