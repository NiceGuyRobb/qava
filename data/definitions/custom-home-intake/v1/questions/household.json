      "required": false,
      "props": {
        "fields": [
          {
            "key": "type",
            "label": "Type of pet",
            "component": "short_text"
          },
          {
            "key": "requirements",
            "label": "Home-related requirements",
            "component": "multi_select",
            "options": [
              "Pet wash",
              "Secure outdoor area",
              "Pet door",
              "Feeding station",
              "Litter area",
              "Durable flooring",
              "Other"
            ]
          }
        ]
      }
    },
    {
