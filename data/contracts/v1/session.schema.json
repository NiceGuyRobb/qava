{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qava.dev/contracts/v1/session.schema.json",
  "title": "Qava session snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "questionnaire_id", "questionnaire_version", "revision", "status", "data", "health", "insights"],
  "properties": {
    "id": { "type": "string" },
    "questionnaire_id": { "type": "string" },
    "questionnaire_version": { "type": "integer", "minimum": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["active", "completed"] },
    "active_topic_id": { "type": ["string", "null"] },
    "data": { "type": "object" },
    "topic_state": { "type": "object", "additionalProperties": { "$ref": "#/$defs/topicState" } },
    "health": { "$ref": "#/$defs/health" },
    "insights": { "type": "array", "items": { "$ref": "insight.schema.json" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "health": {
      "type": "object",
      "properties": {
        "completeness": { "type": "number", "minimum": 0, "maximum": 100 },
        "validity": { "type": "number", "minimum": 0, "maximum": 100 },
        "consistency": { "type": "number", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
        "specificity": { "type": "number", "minimum": 0, "maximum": 100 },
        "overall": { "type": "number", "minimum": 0, "maximum": 100 },
        "readiness": { "enum": ["not_ready", "needs_attention", "ready"] },
        "calculation_version": { "type": "integer" }
      }
    },
    "topicState": {
      "type": "object",
      "required": ["status", "answered_question_ids", "applicable_question_ids", "pending_clarification_ids", "progress", "health"],
      "properties": {
        "status": { "enum": ["not_started", "in_progress", "complete"] },
        "answered_question_ids": { "type": "array", "items": { "type": "string" } },
        "applicable_question_ids": { "type": "array", "items": { "type": "string" } },
        "pending_clarification_ids": { "type": "array", "items": { "type": "string" } },
        "progress": { "type": "number", "minimum": 0, "maximum": 100 },
        "health": { "$ref": "#/$defs/health" }
      }
    }
  }
}
