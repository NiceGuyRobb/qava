{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qava.dev/contracts/v1/insight.schema.json",
  "title": "Evidence-backed insight",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title", "summary", "evidence", "confidence", "generated_at_revision"],
  "properties": {
    "id": { "type": "string" },
    "type": { "enum": ["answer", "topic", "cross_topic"] },
    "topic_id": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "observations": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "object" } },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value"],
        "properties": { "path": { "type": "string" }, "value": {} }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "generated_at_revision": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
